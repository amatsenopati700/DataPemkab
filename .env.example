# ═══════════════════════════════════════════════════════
# Data Wonosobo — Environment Variables
# ═══════════════════════════════════════════════════════

# ── Database (PostgreSQL) ─────────────────────────────
# Di Vercel: Set di Settings > Environment Variables
# Di lokal: Copy file ini ke .env.local dan isi nilainya

# Pooled connection string (digunakan oleh aplikasi)
# Contoh Neon: postgresql://user:pass@ep-xxx.region.pooler.neon.tech/dbname?sslmode=require
# Contoh Supabase: postgresql://postgres:pass@db.xxx.supabase.co:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Direct connection string (digunakan oleh prisma migrate/db push)
# Untuk lokal, bisa sama dengan DATABASE_URL
# Untuk Vercel: Set juga DIRECT_URL ke non-pooled connection
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ── Vercel (otomatis di-set Vercel, tidak perlu manual) ──
# VERCEL=true